{
  "name": "umldraw",
  "private": true,
  "version": "0.1.0",
  "description": "A modern, Excalidraw-based UML diagram builder for the browser",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/copy-fonts.mjs",
    "dev": "npm run prepare:assets && vite",
    "build": "npm run prepare:assets && tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  }
}
