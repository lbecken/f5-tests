{
  "name": "vital-signs-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time patient vital signs chart (React + D3) with a device-simulator server, SSE stream and REST ingest endpoint",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.mjs",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "cross-env NODE_ENV=production node server/index.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
